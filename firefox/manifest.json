{
  "manifest_version": 3,
  "name": "Rede limpa",
  "version": "1.1.0",
  "description": "Painel DevTools com Kaspersky oculto e cores por método HTTP. Mantém bloqueio GET XHR/fetch do host configurado.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "devtools_page": "devtools.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kaspersky_polling",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{c3ac2ad4-c302-48e3-8ea6-8f986e14b481}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
